{% if post.data.categories %}
    {% set categoryList = post.data.categories %}
{% else %}
    {% set categoryList = categories %}
{% endif %}

<ul class="flex flex-wrap gap-2 mb-5">
    {%- for cat in categoryList -%}
        <li>
            <a href="/category/{{ cat | slug }}/" class="inline-block bg-accent-soft text-accent rounded-full text-sm uppercase font-medium tracking-[0.06em] px-3 py-1 hover:bg-accent hover:text-ivory transition-colors">{{ categoryLabels[cat] or cat }}</a>
        </li>
    {%- endfor -%}
</ul>
