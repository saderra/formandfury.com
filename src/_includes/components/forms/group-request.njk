<form id="contact" class="max-w-[90%] mt-10" name="Dr. Freer Group Request" method="POST" data-netlify="true" action="/contact/success">

<label for="name" class="hidden" aria-label="Enter Your Name">Your Name:</label>
<input type="text" placeholder="Name" name="name" />

<label for="email" class="hidden" aria-label="Enter Your Email">Your Email:</label>
<input type="email" placeholder="Email" name="email" />

<label for="phone" class="hidden" aria-label="Enter Your Phone Number">Your Phone Number:</label>
<input type="phone" placeholder="Phone" name="phone" />


<label for="message" class="hidden" aria-label="Enter Your Message">Any specific questions or concerns?</label>
<textarea placeholder="Any specific questions or concerns?" name="message"></textarea>

<button type="submit" class="bg-cfpurple rounded-md text-white poppins px-6 py-3 min-w-[200px]">Send Message</button>

</form>
