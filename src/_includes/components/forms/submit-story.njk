<form id="contact" class="max-w-[90%] mt-10" name="{{ site.title }} Submit A Story" method="POST" data-netlify="true" enctype="multipart/form-data" action="/submit-a-story/">

<label for="name" class="hidden" aria-label="Enter Your Name">Your Name:</label>
<input type="text" placeholder="Name" name="name" />

<label for="email" class="hidden" aria-label="Enter Your Email">Your Email:</label>
<input type="email" placeholder="Email" name="email" />

<label for="event" class="hidden" aria-label="Sport or Event">Sport or Event:</label>
<input type="text" placeholder="Sport or Event" name="event" />

<label for="message" class="hidden" aria-label="Tell Us About It">Tell Us About It:</label>
<textarea placeholder="Tell us about the event, the athletes involved, and why it belongs on Form & Fury." name="message"></textarea>

<label for="photo" class="hidden" aria-label="Upload A Photo">Upload A Photo:</label>
<input type="file" accept="image/*" name="photo" />

<button type="submit" class="bg-brand hover:bg-accent transition-colors rounded-full text-ivory px-8 py-3 min-w-[200px] capitalize text-sm tracking-[0.1em] font-medium">Submit Story</button>

</form>
