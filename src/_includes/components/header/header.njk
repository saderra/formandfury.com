{% include "components/header/off-canvas.njk" %}
{% include "components/header/top.njk" %}
<header class="sticky top-0 bg-ivory border-b border-line z-50">
<nav x-data="{ open: false }" role="navigation" aria-label="Main Menu">
<div class="container">
    <div class="flex items-center justify-between py-3 lg:py-4">

    <div class="flex-shrink-0">
        {% include "components/global/logo.njk" %}
    </div>

    <div class="flex items-center gap-2">
        {% set searchInputId = "header-search-desktop" %}
        {% set variant = "site-search--compact hidden lg:block" %}
        {% include "components/header/search-box.njk" %}

        {% include "components/header/mobile-button.njk" %}
    </div>

    </div>

</div>
<div class="container border-t border-line hidden lg:block">
    <div class="flex items-stretch justify-between h-14">
    {% include "components/header/desktop-links.njk" %}
    <div class="flex items-center">
        <a href="/submit-a-story/" class="inline-flex items-center bg-[#90384a] hover:bg-[#7a2f3f] transition-colors rounded-full text-ivory px-5 py-2 text-sm font-semibold tracking-[0.02em]">Submit A Story</a>
    </div>
    </div>
</div>
</nav>
</header>
<div class="lg:hidden bg-ivory border-b border-line">
    <div class="container py-3">
        {% set searchInputId = "header-search-mobile" %}
        {% set variant = "site-search--full" %}
        {% include "components/header/search-box.njk" %}
    </div>
</div>
