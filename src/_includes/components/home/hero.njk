<section x-data="{ active: 0 }" x-init="setInterval(() => { active = (active + 1) % {{ heroPosts.length }} }, 6000)" class="relative bg-brand-dark text-ivory overflow-hidden">
    {% for post in heroPosts %}
    <div{% if not loop.first %} x-cloak{% endif %} x-show="active === {{ loop.index0 }}" x-transition:enter="transition-opacity duration-1000" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" class="relative aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]">
        <a href="{{ post.url }}" class="absolute inset-0 block" aria-hidden="true" tabindex="-1">
            {% if post.data.imageMetadata %}
                {{ post.data.imageMetadata | renderImage({ alt: "", class: "w-full h-full object-cover", sizes: "100vw", loading: (loop.first and "eager") or "lazy", fetchpriority: (loop.first and "high") or "auto" }) | safe }}
            {% endif %}
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/90 via-brand-dark/20 to-transparent"></div>
        </a>
        <div class="absolute inset-0 flex flex-col justify-end pb-8 md:pb-16 pointer-events-none">
            <div class="container">
                <div class="max-w-2xl text-left">
                    <div class="pointer-events-auto inline-block">
                        {% include "components/blog/topics.njk" %}
                    </div>
                    <a href="{{ post.url }}" class="pointer-events-auto block">
                        <h2 class="font-serif italic text-4xl md:text-6xl font-medium leading-tight">{{ post.data.title }}</h2>
                        <p class="mt-4 text-ivory/80 max-w-xl hidden md:block">{{ post.data.summary }}</p>
                        <div class="mt-5 text-sm capitalize tracking-[0.1em] text-ivory/60">{{ post.data.date | postDate }} &middot; by {{ post.data.author }}</div>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}

    <div class="absolute bottom-6 right-6 md:right-10 flex z-10">
        {% for post in heroPosts %}
        <button @click="active = {{ loop.index0 }}" class="flex items-center justify-center w-6 h-6" aria-label="Show slide {{ loop.index }}">
            <span :class="active === {{ loop.index0 }} ? 'bg-ivory' : 'bg-ivory/40'" class="block w-2 h-2 rounded-full transition-colors"></span>
        </button>
        {% endfor %}
    </div>
</section>
