<section x-data="{ active: 0 }" x-init="setInterval(() => { active = (active + 1) % {{ heroPosts.length }} }, 6000)" class="relative bg-black text-white overflow-hidden">
    {% for post in heroPosts %}
    <div x-show="active === {{ loop.index0 }}" x-transition:enter="transition-opacity duration-700" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" class="relative aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]">
        <a href="{{ post.url }}" class="absolute inset-0 block">
            {% if post.data.imageMetadata %}
                {{ post.data.imageMetadata | renderImage({ alt: post.data.title, class: "w-full h-full object-cover", sizes: "100vw" }) | safe }}
            {% endif %}
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-12">
                <div class="max-w-2xl">
                    {% include "components/blog/topics.njk" %}
                    <h2 class="font-serif text-3xl md:text-5xl font-semibold mt-4 leading-tight">{{ post.data.title }}</h2>
                    <p class="mt-3 text-white/80 max-w-xl hidden md:block">{{ post.data.summary }}</p>
                    <div class="mt-4 text-xs uppercase tracking-wide text-white/70">{{ post.data.date | postDate }} &middot; by {{ post.data.author }}</div>
                </div>
            </div>
        </a>
    </div>
    {% endfor %}

    <div class="absolute bottom-4 right-4 md:right-8 flex gap-2 z-10">
        {% for post in heroPosts %}
        <button @click="active = {{ loop.index0 }}" :class="active === {{ loop.index0 }} ? 'bg-white' : 'bg-white/40'" class="w-2.5 h-2.5 rounded-full" aria-label="Show slide {{ loop.index }}"></button>
        {% endfor %}
    </div>
</section>
