<div class="py-5 border-b border-line" id="crumbbar">
<div class="container">
    <nav class="flex" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center flex-wrap gap-x-2 text-sm capitalize tracking-[0.06em] text-brand-bright">
            <li><a href="/" class="hover:text-accent transition-colors">Home</a></li>

            {% if catLabel %}
                <li aria-hidden="true">/</li>
                <li><a href="{{ catUrl or '/category/' + (catLabel | slug) + '/' }}" class="hover:text-accent transition-colors">{{ catLabel }}</a></li>
            {% endif %}

            {% if crumbTitle %}
                <li aria-hidden="true">/</li>
                <li class="text-brand truncate max-w-xs sm:max-w-md normal-case tracking-normal">{{ crumbTitle }}</li>
            {% endif %}
        </ol>
    </nav>
</div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ (site.url + "/") | dump | safe }} }
    {%- if catLabel %},
    { "@type": "ListItem", "position": 2, "name": {{ catLabel | dump | safe }}, "item": {{ (site.url + (catUrl or '/category/' + (catLabel | slug) + '/')) | dump | safe }} }
    {%- endif %}
    {%- if crumbTitle %},
    { "@type": "ListItem", "position": {{ 3 if catLabel else 2 }}, "name": {{ crumbTitle | dump | safe }}, "item": {{ (site.url + page.url) | dump | safe }} }
    {%- endif %}
  ]
}
</script>
