<div class="py-4 border-b border-black" id="crumbbar">
<div class="container">
    <nav class="flex" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center flex-wrap gap-x-2 text-sm text-brand-bright">
            <li><a href="/" class="hover:text-black">Home</a></li>

            {% if catLabel %}
                <li aria-hidden="true">/</li>
                <li><a href="{{ catUrl or '/category/' + (catLabel | slug) + '/' }}" class="hover:text-black">{{ catLabel }}</a></li>
            {% endif %}

            {% if crumbTitle %}
                <li aria-hidden="true">/</li>
                <li class="text-black truncate max-w-xs sm:max-w-md">{{ crumbTitle }}</li>
            {% endif %}
        </ol>
    </nav>
</div>
</div>
