{% set sbheader = "pb-4 border-b border-stone-300 mb-4" %}

<div class="col-span-12 lg:col-span-4" id="sidebar">

    <div>
    <h2 class="{{ sbheader }}">Scheduling</h2>
    {% include "components/global/appointment.njk" %}

    </div>





        {% if hideIntro != true %} 
        <div>
            <h2 class="{{ sbheader }}">About Corinne</h2>
            <p class="leading-7 mb-6 pr-6 text-stone-700">{{ site.sidebarintro }}</p>
        </div>
        {% endif %} 










         <div>
            <h2 class="{{ sbheader }}">Article Topics</h2>
            <ul>
                {%- for cat in collections.getCat -%}
                    <li class="block"> 
                        <a href="/articles/categories/{{ cat | slug }}" class="inline-block capitalize p-4 text-center text-warm-600 w-full rounded-md my-2 border border-warm-200 hover:bg-warm-100/50 poppins font-medium"> {{ cat | title }} </a>    
                    </li>
                {%- endfor -%} 
            </ul>
        </div>









</div>