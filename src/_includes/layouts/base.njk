<!DOCTYPE html>
<html lang="en">
{% include "components/head/head.njk" %}
<body {% if layout %}class="{{ layout }} {{ bodyClass }}"{% endif %}>
{% include "components/header/header.njk" %}

<section class="bg-ivory" data-pagefind-body>
   {% block mainContent %}{% endblock %}
</section>

{% include "components/footer/footer.njk" %}

<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/cms/";
        });
      }
    });
  }
</script>

</body>
</html>