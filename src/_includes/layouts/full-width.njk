{% extends "layouts/base.njk" %}
{% block mainContent %}


    <div class="container pt-12 md:pt-16 pb-24">

    <article class="prose prose-xl max-w-3xl">

        {% if mast %}
            <img src="/assets/images/mast/{{ mast }}" alt="{{ title }} intro image" class="w-full rounded-md">

        {% else %}
         <h1 class="font-serif italic font-medium text-5xl md:text-6xl pb-8 mb-8 border-b border-line">{{ title }}</h1>
        {% endif %}

       
        {{ content | safe }}
    </article>


    </div>

{% endblock %}


