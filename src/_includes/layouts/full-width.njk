{% extends "layouts/base.njk" %}
{% block mainContent %}


    <div class="container pt-8 pb-16">

    <article class="prose prose-lg max-w-3xl">

        {% if mast %}
            <img src="/assets/images/mast/{{ mast }}" alt="{{ title }} intro image" class="w-full rounded-md">

        {% else %}
         <h1 class="font-heading uppercase tracking-tight text-3xl md:text-4xl pb-8 mb-8 border-b border-black">{{ title }}</h1>
        {% endif %}

       
        {{ content | safe }}
    </article>


    </div>

{% endblock %}


