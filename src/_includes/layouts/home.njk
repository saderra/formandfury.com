{% extends "layouts/base.njk" %}
{% block mainContent %}

{% set latest = collections.articles | reverse %}
{% set heroPosts = latest.slice(0, 5) %}
{% set featured = latest[0] %}
{% set listNext = latest.slice(1, 5) %}
{% set gridNext = latest.slice(5, 14) %}

{% include "components/home/hero.njk" %}

<div class="container py-20 md:py-28">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 pb-20 border-b border-line">
        <div>
            {% set post = featured %}
            {% include "components/blog/card.njk" %}
        </div>
        <div class="space-y-8">
            {% for post in listNext %}
                <div class="flex gap-5 items-start pb-8 border-b border-line last:border-0 last:pb-0">
                    <a href="{{ post.url }}" class="flex-shrink-0 w-28 h-20 block overflow-hidden bg-subtle rounded-lg">
                        {% if post.data.imageMetadata %}
                            {{ post.data.imageMetadata | renderImage({ alt: post.data.title, class: "w-full h-full object-cover", sizes: "112px" }) | safe }}
                        {% endif %}
                    </a>
                    <div>
                        {% include "components/blog/topics.njk" %}
                        <h3 class="text-xl font-heading font-medium leading-snug">
                            <a href="{{ post.url }}" class="hover:text-accent transition-colors">{{ post.data.title }}</a>
                        </h3>
                        <p class="text-base text-brand-bright leading-6 mt-2">{{ post.data.summary }}</p>
                        <time class="text-sm text-brand-bright capitalize tracking-[0.08em] mt-2 block">{{ post.data.date | postDate }}</time>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <h2 class="font-heading italic text-4xl mt-20 mb-10">Latest Stories</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14">
        {% for post in gridNext %}
            {% include "components/blog/card.njk" %}
        {% endfor %}
    </div>

</div>

{% endblock %}
