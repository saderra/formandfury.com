{% extends "layouts/base.njk" %}
{% block mainContent %}

{% if catPage %}
    {% set catLabel = categoryLabels[catPage.cat] or catPage.cat %}
    {% include "components/section/breadcrumb.njk" %}
    <div class="container pt-8">
        <h1 class="font-heading uppercase tracking-tight text-4xl md:text-5xl mb-8">{{ catLabel }}</h1>
    </div>
{% endif %}

<main class="container grid gap-0 lg:gap-10 grid-cols-12 pb-16">
    <div class="col-span-12 lg:col-span-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% if catPage %}
            {% set postList = catPage.posts %}
        {% else %}
            {% set postList = collections.articles | reverse %}
        {% endif %}
        {%- for post in postList -%}
            {% include "components/blog/card.njk" %}
        {%- endfor -%}
        </div>

        {% if catPage and catPage.totalPages > 1 %}
        <nav class="flex items-center justify-between mt-10 pt-6 border-t border-black" aria-label="Category pagination">
            {% if catPage.pageIndex > 0 %}
                <a href="{% if catPage.pageIndex == 1 %}/category/{{ catPage.cat | slug }}/{% else %}/category/{{ catPage.cat | slug }}/page/{{ catPage.pageIndex }}/{% endif %}" class="uppercase text-sm font-medium border border-black rounded px-5 py-3 hover:bg-black hover:text-white">&laquo; Newer Posts</a>
            {% else %}
                <span></span>
            {% endif %}
            {% if catPage.pageIndex + 1 < catPage.totalPages %}
                <a href="/category/{{ catPage.cat | slug }}/page/{{ catPage.pageIndex + 2 }}/" class="uppercase text-sm font-medium border border-black rounded px-5 py-3 hover:bg-black hover:text-white">Older Posts &raquo;</a>
            {% else %}
                <span></span>
            {% endif %}
        </nav>
        {% endif %}
    </div>

    {% include "components/section/sidebar.njk" %}
</main>
{% endblock %}
